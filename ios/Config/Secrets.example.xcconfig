// Bu dosyayı Secrets.xcconfig adıyla kopyalayın (git'e girmez).
// xcconfig'te "//" yorum başlatır; URL'de "https:/$()/" yazımı bu yüzdendir.
//
// Yerel Supabase (Mac'te `supabase start`): anahtar `supabase status` çıktısındaki
// "anon key"dir. Simülatör 127.0.0.1'e erişir; gerçek iPhone için Mac'in yerel IP'si yazılır.
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_ANON_KEY = buraya-yerel-anon-anahtari
